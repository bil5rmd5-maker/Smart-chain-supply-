async function generateReportFromAI(userInput) {
    const response = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer YOUR_OPENAI_API_KEY' // ضع مفتاح API الخاص بك هنا
        },
        body: JSON.stringify({
            model: "gpt-4o",
            messages: [{ role: "user", content: `قم بتحليل المشكلة التالية وإعطاء تقرير استشاري هندسي: ${userInput}` }]
        })
    });
    const data = await response.json();
    console.log(data.choices[0].message.content);
}
